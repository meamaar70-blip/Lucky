@echo off
chcp 65001 >nul 2>nul
setlocal enabledelayedexpansion
cd /d "%~dp0"

echo ============================================
echo   ساخت HTTPS خودکار برای Lucky
echo ============================================
echo.

where powershell >nul 2>nul
if errorlevel 1 (echo  [X] PowerShell پیدا نشد. & pause & exit /b 1)

REM ---------- ۱) Caddy ----------
if exist "caddy.exe" goto :have_caddy
echo  [1/3] دانلود Caddy ...
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "try { Invoke-WebRequest -UseBasicParsing 'https://caddyserver.com/api/download?os=windows&arch=amd64' -OutFile 'caddy.zip'; Expand-Archive -LiteralPath 'caddy.zip' -DestinationPath '.' -Force; Remove-Item 'caddy.zip' -Force } catch { Write-Host $_.Exception.Message }"
if not exist "caddy.exe" (
  echo  [X] دانلود خودکار نشد. دستی از https://caddyserver.com/download نسخهٔ Windows amd64 را بگیر
  echo      و caddy.exe را همین‌جا (کنار این فایل) بگذار، بعد دوباره اجرا کن.
  pause
  exit /b 1
)
:have_caddy
echo  [1/3] caddy.exe آماده است.

REM ---------- ۲) نام دامنه ----------
echo  [2/3] گرفتن آی‌پی عمومی ...
set "IP="
for /f "usebackq delims=" %%i in (`powershell -NoProfile -Command "(Invoke-RestMethod https://api.ipify.org -TimeoutSec 15)"`) do set "IP=%%i"
if "%IP%"=="" (
  echo  [X] آی‌پی عمومی به دست نیامد. اینترنت سرور را چک کن.
  pause
  exit /b 1
)
set "HOSTNAME=lucky-!IP:.=-!.sslip.io"
echo        آی‌پی: !IP!
echo        دامنه: !HOSTNAME!

REM ---------- ۳) نوشتن Caddyfile ----------
echo  [3/3] نوشتن Caddyfile ...
> "Caddyfile" echo # generated by setup-https.bat
>> "Caddyfile" echo !HOSTNAME! {
>> "Caddyfile" echo 	encode zstd gzip
>> "Caddyfile" echo 	request_body {
>> "Caddyfile" echo 		max_size 200MB
>> "Caddyfile" echo 	}
>> "Caddyfile" echo 	reverse_proxy 127.0.0.1:3000 {
>> "Caddyfile" echo 		transport http {
>> "Caddyfile" echo 			read_timeout 10m
>> "Caddyfile" echo 			write_timeout 10m
>> "Caddyfile" echo 		}
>> "Caddyfile" echo 	}
>> "Caddyfile" echo 	header {
>> "Caddyfile" echo 		@nocache path /sw.js /manifest.webmanifest
>> "Caddyfile" echo 		header @nocache Cache-Control "no-cache"
>> "Caddyfile" echo 		-Server
>> "Caddyfile" echo 	}
>> "Caddyfile" echo }

echo.
echo ============================================
echo   آدرس نهایی تو:  https://!HOSTNAME!
echo ============================================
echo.
echo  حالا این پنجره را باز نگه دار. چند ثانیه بعد در مرورگر باز کن:
echo      https://!HOSTNAME!/api/health
echo.
echo  یادت باشد Lucky هم باید در حال اجرا باشد (start-lucky.bat یا سرویس).
echo  برای توقف: Ctrl+C
echo.
.\caddy.exe run --config Caddyfile
